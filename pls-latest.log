  formData: {
    q1: {
      label: 'Assessment & Plan',
      answer: `{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"patient had fever and cough on and off for almost a week. He saw a GP on Monday and was given Augmentin. He took and vomited and stopped the meds. He did not get better, cough with brown phlegm (little) and was not SOB but not feeling well. LOA, no LOW. No RN/ST. Slight Body aches."}]},{"type":"paragraph","content":[{"type":"text","text":"He saw another GP yesterday and was given paracetamol. He took one dose last night and temp was 37.7C. This morning no fever meds taken. COVID ART/ FLU A/B done at GP Clinic negative"}]},{"type":"paragraph","content":[{"type":"text","text":"PH: on Amlo 5 for HT, Rosuvastatin for HL, saw a cardiologist for health checkup and was given Clopidogrel and mecobalamin. No asthma/bronchitis. No MI before. No DM."}]},{"type":"paragraph","content":[{"type":"text","text":"Clinically he appeared weak. slight dyspneic, SPO2 on 2L O2 95-96%, No SOB. mild pharyngitis, tonsils slightly swollen. No blocked /runny nose."}]},{"type":"paragraph","content":[{"type":"text","text":"H/L: clear. AE slightly soft. Abd soft, nontender, no mass."}]},{"type":"paragraph","content":[{"type":"text","text":"CNS: no gross abnormality."}]},{"type":"paragraph","content":[{"type":"text","text":"ECG: some ST depression on lateral leads."}]},{"type":"paragraph","content":[{"type":"text","text":"Dr Steve Yang contacted: He will see patient soon"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"for IV paracetamol/IV drip Hartman's, blood for GFU/CRP"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"blood for culture & sensitivity"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"CXR"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"ADD RESPY MULTIPLEX(PCR TEST)"}]},{"type":"paragraph"},{"type":"paragraph"}]}`,
      rows: 5
    },
    q2: {
      label: 'Nursing Notes',
      answer: '{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"FEVER FOR 1 WEEK, COUGH."}]},{"type":"paragraph","content":[{"type":"text","text":"PT CLAIMED NO DIFFICULTY IN BREATHING, BUT THE OXYGEN SATURATION IS 90 -91% ON AIR."}]},{"type":"paragraph","content":[{"type":"text","text":"WENT TO GP CLINIC, WAS GIVEN ANTIBIOTIC (AUGMENTIN)"}]},{"type":"paragraph","content":[{"type":"text","text":"HOWEVER, HE DEVELOP VOMITING AFTER TAKEN AUGMENTIN. --ONLY COMPLETE 2 DOSES, THEN WAS INSTRUCTED BY THE GP DOCTOR TO STOP THE ANTIBIOTIC."}]},{"type":"paragraph"}]}',
      rows: 5
